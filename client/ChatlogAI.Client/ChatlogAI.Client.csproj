<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ChatlogAI</AssemblyName>
    <RootNamespace>ChatlogAI.Client</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 图标：替换 Assets\app.ico 即可，详见 docs/DOTNET_CLIENT_PLAN.md §9 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Product>Chatlog AI</Product>
    <AssemblyTitle>Chatlog AI</AssemblyTitle>
    <Company>Chatlog AI</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
