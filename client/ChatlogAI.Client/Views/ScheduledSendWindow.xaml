<Window x:Class="ChatlogAI.Client.Views.ScheduledSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="580"
        MaxHeight="780"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CardBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 定时发送任务的编辑器。配色与控件样式一律来自 Themes/Theme.xaml，
         只把主题里还没有的 CheckBox 样式临时定义在本窗口资源里（与 AutoReplyWindow 同一处理），
         避免为一个控件去动公共文件。 -->

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FormHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Aero2 默认 CheckBox 的选中色是系统蓝，与微信绿主题冲突，必须自带 ControlTemplate。
             理由同 Theme.xaml 第 10 节：默认模板的 ControlTemplate.Triggers 优先级高于 Style.Triggers，
             只改 Style 是改不动的。 -->
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="3"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="Tick"
                                          Data="M 0,3.5 L 3,6.5 L 8,1"
                                          Stroke="{DynamicResource TextOnAccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </MultiTrigger>
                            <!-- 声明在最后：勾选与禁用同时成立时，禁用态说了算。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 星期几的小勾选块：内容只有一个字，不需要普通 CheckBox 那么长的默认间距。 -->
        <Style x:Key="WeekdayCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ThemedCheckBox}">
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,16,18,4">
            <StackPanel>

                <!-- ==================== 开关 ==================== -->
                <CheckBox Style="{StaticResource ThemedCheckBox}"
                          Content="启用这条任务"
                          IsChecked="{Binding TaskEnabled, Mode=TwoWay}" />

                <TextBlock Style="{StaticResource FormHint}"
                           Margin="0,6,0,14"
                           Text="总开关在左侧面板上；这里只是本任务自己的启用状态。" />

                <!-- ==================== 发送对象 ==================== -->
                <TextBlock Style="{StaticResource FormLabel}" Text="发送对象" />
                <ComboBox Width="320"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding ChatOptions}"
                          SelectedItem="{Binding SelectedChat, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource FormHint}"
                           Margin="0,6,0,14"
                           Text="{Binding ChatPlaceholder}" />

                <!-- ==================== 触发方式 ==================== -->
                <TextBlock Style="{StaticResource FormLabel}" Text="触发方式" />
                <ComboBox Width="180"
                          HorizontalAlignment="Left"
                          SelectedValue="{Binding Mode, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="每天固定时刻" Tag="daily" />
                    <ComboBoxItem Content="按星期几" Tag="weekly" />
                    <ComboBoxItem Content="固定间隔" Tag="interval" />
                    <ComboBoxItem Content="只发一次" Tag="once" />
                </ComboBox>

                <!-- 每天 / 每周共用"当天该时刻" -->
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsFixedTimeMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="时刻" />
                        <TextBox Width="80"
                                 Margin="8,0,0,0"
                                 Text="{Binding TimeOfDay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="24 小时制，例如 09:00" />
                    </StackPanel>
                </StackPanel>

                <!-- 仅按星期几时出现 -->
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsWeeklyMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="星期" />
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox Style="{StaticResource WeekdayCheckBox}" Content="一" IsChecked="{Binding Monday, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource WeekdayCheckBox}" Content="二" IsChecked="{Binding Tuesday, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource WeekdayCheckBox}" Content="三" IsChecked="{Binding Wednesday, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource WeekdayCheckBox}" Content="四" IsChecked="{Binding Thursday, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource WeekdayCheckBox}" Content="五" IsChecked="{Binding Friday, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource WeekdayCheckBox}" Content="六" IsChecked="{Binding Saturday, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource WeekdayCheckBox}" Content="日" IsChecked="{Binding Sunday, Mode=TwoWay}" />
                    </WrapPanel>
                </StackPanel>

                <!-- 固定间隔 -->
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsIntervalMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="每" />
                        <TextBox Width="80"
                                 Margin="8,0,0,0"
                                 Text="{Binding IntervalMinutesText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="8,0,0,0" Text="分钟发一次（1 至 10080）" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FormHint}"
                               Margin="0,6,0,0"
                               Text="首次启用只记录基线、不立即发送，等满一个间隔后才会发出第一条。" />
                </StackPanel>

                <!-- 一次性 -->
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsOnceMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="日期" />
                        <TextBox Width="120"
                                 Margin="8,0,0,0"
                                 Text="{Binding RunDateText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 2026-09-12" />
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="12,0,0,0" Text="时刻" />
                        <TextBox Width="80"
                                 Margin="8,0,0,0"
                                 Text="{Binding RunTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 09:00" />
                    </StackPanel>
                </StackPanel>

                <!-- ==================== 节奏 ==================== -->
                <TextBlock Style="{StaticResource FormLabel}" Margin="0,16,0,6" Text="发送节奏" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="冷却" />
                    <TextBox Width="70"
                             Margin="8,0,0,0"
                             Text="{Binding CooldownMinutesText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="6,0,0,0" Text="分钟" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="18,0,0,0" Text="随机推迟" />
                    <TextBox Width="70"
                             Margin="8,0,0,0"
                             Text="{Binding JitterMinutesText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="6,0,0,0" Text="分钟" />
                </StackPanel>
                <TextBlock Style="{StaticResource FormHint}"
                           Margin="0,6,0,14"
                           Text="冷却：距上次发送未满该时长一律不发。随机推迟：在应发时刻之后 0 至该分钟内随机挑一个时刻发出，用来更像真人；两处填 0 表示不启用。" />

                <!-- ==================== 内容 ==================== -->
                <TextBlock Style="{StaticResource FormLabel}" Text="上下文条数与专属提示词" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="携带上下文" />
                    <TextBox Width="70"
                             Margin="8,0,0,0"
                             Text="{Binding ContextCountText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="6,0,0,0" Text="条（1 至 2000）" />
                </StackPanel>
                <TextBox Margin="0,8,0,0"
                         Height="72"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="留空则只用内置的打招呼提示词" />
                <TextBlock Style="{StaticResource FormHint}"
                           Margin="0,6,0,14"
                           Text="留空则只用内置提示词（先概括最近聊到哪，再据此写一条不突兀的招呼）。" />

                <!-- ==================== 预览 ==================== -->
                <TextBlock Style="{StaticResource FormLabel}" Text="预览结果" />
                <TextBox Height="72"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding PreviewText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource FormHint}"
                           Margin="0,6,0,4"
                           Text="点「预览」只生成不发送；点「试发」会真实往微信发出这条消息。" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="预览"
                            MinWidth="80"
                            Command="{Binding PreviewCommand}" />
                    <Button Content="试发"
                            Margin="8,0,0,0"
                            MinWidth="80"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding TestSendCommand}"
                            Visibility="{Binding IsSendAvailable, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            MinWidth="80"
                            Click="OnCancelClick" />
                    <Button Content="保存"
                            Margin="8,0,0,0"
                            MinWidth="80"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
