<Window x:Class="ChatlogAI.Client.Views.MomentsExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出朋友圈"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 用模态对话框（ShowDialog）而不是模块内遮罩，与 ExportWindow / AutoReplyWindow 同一形态：
         它需要弹系统「另存为」（必须以窗口为 owner 才能正确置顶），并有自己的轮询生命周期。
         为什么不是"点一下就把 ZIP 存下来"：朋友圈导出是**异步任务**，产物在微信数据源侧生成，
         中间要经过创建 → 轮询 → 下载三步，只有一个窗口才装得下这条进度线。 -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 行 0：标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="导出朋友圈"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="产物是一个 ZIP 压缩包，保存在你选择的位置。"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Height="1"
                Margin="0,14,0,14"
                Background="{DynamicResource LineBrush}" />

        <!-- 行 2：导出选项。进行中整块禁用（IsIdle），避免"改着改着，导出的是另一套参数"。 -->
        <StackPanel Grid.Row="2" IsEnabled="{Binding IsIdle}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="导出格式"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Left"
                          MinWidth="220"
                          ItemsSource="{Binding Formats}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="导出范围"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Left"
                          MinWidth="220"
                          ItemsSource="{Binding Scopes}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedScope, Mode=TwoWay}">
                    <!-- 没筛出任何人时「当前筛选的人」不可选：选了只会导出一份空包。
                         基于既有 ComboBoxItem 样式加一条 IsEnabled，不重写模板。 -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- 行 3：格式说明。这句不是装饰：格式由**微信数据源**提供，
             不写清楚用户会以为能选 Markdown（而产物是 ZIP）。 -->
        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="{Binding FormatHint}" />

        <!-- 行 4：状态与进度。文案由 VM 给，颜色只在这里按 IsError 切换。 -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ProgressText}"
                       Margin="0,4,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Visibility="{Binding HasProgressText, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 行 5：关窗说明。本轮没有"取消导出任务"（后端没代理上游的 DELETE，§14.9），
             所以这里只说清"关窗会发生什么"，而不是放一个做不到的取消按钮。 -->
        <TextBlock Grid.Row="5"
                   Margin="0,10,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="{Binding CloseHint}" />

        <!-- 行 6：按钮。关闭始终可用 —— 导出中途反悔也能关，关窗会取消在途的轮询与下载。 -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="关闭"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Command="{Binding CloseCommand}" />
            <Button Content="开始导出"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Command="{Binding ExportCommand}" />
        </StackPanel>
    </Grid>
</Window>
