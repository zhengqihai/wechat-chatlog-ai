<Window x:Class="ChatlogAI.Client.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出聊天记录"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 用模态对话框（ShowDialog）而不是主界面里的内联遮罩，与 StartupWindow 的账号选择相反：
         那个只活几秒、状态极简；这个需要弹系统「另存为」（必须以窗口为 owner 才能正确置顶），
         且有自己的取数/写盘生命周期，独立窗口在焦点与生命周期上都更清楚。 -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 行 0：导出对象。会话在打开对话框时已被快照（ExportContext），
             导出期间主界面即使切了会话，这里导的仍是"点按钮那一刻"的会话。 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ChatName}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding ChatSubtitle}"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Height="1"
                Margin="0,14,0,14"
                Background="{DynamicResource LineBrush}" />

        <!-- 行 2：导出选项。导出进行中整块禁用（IsIdle），
             避免"改着改着，导出的是另一套参数"。 -->
        <StackPanel Grid.Row="2" IsEnabled="{Binding IsIdle}">

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="导出格式"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <!-- 选项对象 + SelectedItem：格式是枚举，映射关系留在 VM 里（见 ExportModels.cs 注释），
                     XAML 只负责显示 Label，不再写一遍字符串 ↔ 枚举的对照表。 -->
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Left"
                          MinWidth="200"
                          ItemsSource="{Binding Formats}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="时间范围"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <!-- 这里的时间范围是本对话框<b>独立</b>的：默认同步主界面当前筛选，
                     之后各改各的 —— 用户常常想"界面上只看最近 1 小时，但导出一整天"。 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="仅导出最近"
                              VerticalAlignment="Center"
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              IsChecked="{Binding HasTimeLimit, Mode=TwoWay}" />
                    <TextBox Width="64"
                             Margin="8,0,0,0"
                             Text="{Binding TimeValue}"
                             IsEnabled="{Binding IsTimeRangeEnabled}" />
                    <ComboBox Margin="8,0,0,0"
                              ItemsSource="{Binding TimeUnits}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTimeUnit, Mode=TwoWay}"
                              IsEnabled="{Binding IsTimeRangeEnabled}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="附加内容"
                           FontSize="12"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Column="1">
                    <CheckBox Content="包含 AI 对话历史"
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              IsEnabled="{Binding IsAiHistoryEnabled}"
                              IsChecked="{Binding IncludeAiHistory, Mode=TwoWay}" />
                    <!-- 这句提示不是装饰：/api/history 不接受时间范围，勾选后追加的是全量历史，
                         不写清楚就会出现"我明明选了最近 1 小时，怎么冒出去年的对话"。
                         CSV 时换成"为什么这个选项用不了"，避免用户以为点了没反应。 -->
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding AiHistoryHint}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 行 3：状态与说明。文案由 VM 给（进度 / 失败原因），颜色只在这里按 IsError 切换。 -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="0,4,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="单次最多导出 2000 条消息。" />
        </StackPanel>

        <!-- 行 4：按钮。关闭始终可用 —— 即使用户在导出中反悔，关窗会取消在途请求。 -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="关闭"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="导出"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Command="{Binding ExportCommand}" />
        </StackPanel>
    </Grid>
</Window>
