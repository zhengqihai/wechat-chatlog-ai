<UserControl x:Class="ChatlogAI.Client.Views.Modules.ContactsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- ThemedCheckBox 跟着它的使用方走：本模块的分类勾选与每行勾选框都要它。
             刻意**不**提升进 Themes/Theme.xaml —— 那里是全应用共享的调色与控件样式，
             只被一个模块使用的键放进去，等于让"谁在用"这件事从此不可见。
             与 ScheduledSendModuleView / AutoReplyWindow 的处理一致：局部 key，不外扩。 -->
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="3"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="Tick"
                                          Data="M 0,3.5 L 3,6.5 L 8,1"
                                          Stroke="{DynamicResource TextOnAccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </MultiTrigger>
                            <!-- 声明在最后：勾选与禁用同时成立时，禁用态说了算。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 联系人模块（T22）：两列布局 —— 左列内部上下两块（筛选条 + 列表），右列详情区。
         筛选条刻意不单独占一列：七个勾选框 + 搜索框挤进一列根本没法看。
         本控件不设置 DataContext，绑定全部继承 MainWindow 的 MainViewModel。 -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="320" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 行 0：分类勾选 + 搜索。勾选/关键词改动都**不**自动请求，由「应用」或回车触发一次
                     （搜索是服务端过滤，每敲一个字符打一次后端是白花）。 -->
                <StackPanel Grid.Row="0" Margin="14,14,14,8">
                    <TextBlock Text="联系人"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Style="{StaticResource ThemedCheckBox}"
                                  Content="好友"
                                  IsChecked="{Binding Contacts.IncludeFriends, Mode=TwoWay}" />
                        <CheckBox Margin="16,0,0,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  Content="群聊"
                                  IsChecked="{Binding Contacts.IncludeGroups, Mode=TwoWay}" />
                        <CheckBox Margin="16,0,0,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  Content="公众号"
                                  ToolTip="含订阅号 / 服务号（上游把三类分开计数，这里一并取回后再按备注/昵称辨认）"
                                  IsChecked="{Binding Contacts.IncludeOfficials, Mode=TwoWay}" />
                        <CheckBox Margin="16,0,0,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  Content="已删除好友"
                                  IsChecked="{Binding Contacts.IncludeFormerFriends, Mode=TwoWay}" />
                        <CheckBox Margin="16,0,0,0"
                                  Style="{StaticResource ThemedCheckBox}"
                                  Content="黑名单"
                                  IsChecked="{Binding Contacts.IncludeBlocked, Mode=TwoWay}" />
                    </WrapPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Contacts.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按显示名 / 备注 / 微信号搜索，回车即应用（服务端过滤）"
                                 KeyDown="OnKeywordKeyDown" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="应用"
                                Command="{Binding Contacts.ApplyCommand}" />
                    </Grid>
                </StackPanel>

                <!-- 行 1：左「全选 / 反选 / 已选 N / 当前 M / 共 T」，右「格式 + 刷新 + 导出」。
                     联系人导出只有"格式"一个选项，所以不做一个和 ExportWindow 并肩的弹窗，
                     点导出直接弹系统「另存为」。 -->
                <Grid Grid.Row="1" Margin="14,0,14,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="全选"
                                Padding="10,3"
                                MinWidth="0"
                                FontSize="12"
                                ToolTip="把当前筛选结果并入已选（不清掉切换分类前已勾选的）"
                                Command="{Binding Contacts.SelectAllVisibleCommand}" />
                        <Button Content="反选"
                                Margin="6,0,0,0"
                                Padding="10,3"
                                MinWidth="0"
                                FontSize="12"
                                ToolTip="只翻转当前筛选结果的勾选状态"
                                Command="{Binding Contacts.InvertVisibleSelectionCommand}" />
                        <TextBlock Text="{Binding Contacts.CountText}"
                                   Margin="10,0,0,0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Contacts.Formats}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding Contacts.SelectedFormat, Mode=TwoWay}"
                                  MinWidth="130"
                                  FontSize="12" />
                        <Button Margin="6,0,0,0"
                                Content="刷新"
                                Padding="10,3"
                                MinWidth="0"
                                FontSize="12"
                                ToolTip="用当前勾选与关键词重查一次"
                                Command="{Binding Contacts.ApplyCommand}" />
                        <Button Margin="6,0,0,0"
                                Content="导出"
                                Padding="10,3"
                                MinWidth="0"
                                FontSize="12"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding Contacts.ExportCommand}" />
                    </StackPanel>
                </Grid>

                <!-- 行 2：三条横幅，各占一行、按需出现。全部用色 key，不写字面量色值。 -->
                <StackPanel Grid.Row="2" Margin="14,0,14,8">
                    <Border Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerSoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Visibility="{Binding Contacts.HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Contacts.ErrorMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                    <Border Margin="0,6,0,0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Visibility="{Binding Contacts.HasSourceFallback, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Contacts.SourceFallbackText}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Contacts.StatusMessage}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding Contacts.HasStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- 行 3：列表。接口没有分页，一次返回全部（实测 495 条），所以必须用 ListBox
                     自带的容器虚拟化 —— 本项目别处（守护对象 / 定时任务）刻意选了
                     ScrollViewer + ItemsControl，但那些列表只有个位数行，规模不同、选择也应不同。 -->
                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding Contacts.Contacts}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,0,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Multiple">
                        <!-- 把行高亮接到行 VM 的 IsSelected 上：点一行就等于勾上这一行。
                             否则会出现"ListBox 自己一套选中、导出选集另一套"两个互不相干的选择状态，
                             用户点了一行却不确定它算不算"要被导出"的那个。 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource ThemedCheckBox}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="勾选后会被「导出」写进文件；切换分类不会清掉已勾选的" />

                                    <!-- 首字母圆形头像：与会话列表的 AvatarText 同一做法。
                                         这里**不**加载真实头像，只有详情区那一个才去取（见 VM 注释）。 -->
                                    <Border Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            CornerRadius="16"
                                            Background="{DynamicResource SubtleBrush}">
                                        <TextBlock Text="{Binding AvatarText}"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding SecondaryText}"
                                                   Margin="0,3,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- 类型徽标只按 type 显示 friend / group；已删除好友与黑名单没有判别字段，
                                         只能靠用户当前勾选的分类去理解，这里刻意不猜、不编造。 -->
                                    <Border Grid.Column="3"
                                            Padding="6,2"
                                            CornerRadius="3"
                                            Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasTypeBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding TypeBadge}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态 / 加载中：与列表同格、后声明，靠 Z 序盖在上面。 -->
                    <TextBlock Text="{Binding Contacts.Placeholder}"
                               Margin="14,4,14,0"
                               VerticalAlignment="Top"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Contacts.HasContacts}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- 右列详情区。三种状态互斥：恰好勾 1 个看详情（此时才取一次头像）、勾 ≥2 个给概览、
             一个没勾给提示（详情区只跟勾选选集走，与"列表里点了哪一行"是同一件事）。 -->
        <Border Grid.Column="1" Background="{DynamicResource PageBrush}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Contacts.HasDetail, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="24,24,24,24">
                        <Grid Width="72" Height="72" HorizontalAlignment="Left">
                            <Ellipse Fill="{DynamicResource SubtleBrush}" />
                            <TextBlock Text="{Binding Contacts.DetailContact.AvatarText}"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <!-- 头像图取到之前（或取不到）这里什么都不画，下面那个首字母就露出来。 -->
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Contacts.DetailContact.AvatarImage}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <TextBlock Text="{Binding Contacts.DetailContact.DisplayName}"
                                   Margin="0,14,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Contacts.DetailContact.TypeBadge}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="备注" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Contacts.DetailContact.RemarkText}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Text="昵称" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Contacts.DetailContact.NicknameText}"
                                       Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Text="微信号" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Contacts.DetailContact.AliasText}"
                                       Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="3" Text="地区" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding Contacts.DetailContact.RegionText}"
                                       Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="4" Text="来源" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding Contacts.DetailContact.SourceText}"
                                       Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="5" Text="添加时间" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding Contacts.DetailContact.AddTimeText}"
                                       Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24,0,24,0"
                            Visibility="{Binding Contacts.HasMultiSelection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Contacts.MultiSelectionText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="导出会把勾选的联系人全部写进文件。"
                               Margin="0,8,0,0"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24,0,24,0"
                            Visibility="{Binding Contacts.HasNoSelection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="勾选左侧联系人查看详情"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="可以搜索或切换分类后再勾选，已勾选的不会被清掉。"
                               Margin="0,8,0,0"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
