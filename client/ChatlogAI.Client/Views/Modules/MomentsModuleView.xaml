<UserControl x:Class="ChatlogAI.Client.Views.Modules.MomentsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="{DynamicResource TextPrimaryBrush}"
             PreviewKeyDown="OnModuleKeyDown">

    <UserControl.Resources>
        <!-- ThemedCheckBox 与 T22 的处理一致：只被本模块使用的键放在本模块的 Resources 里，
             刻意**不**提升进 Themes/Theme.xaml —— 那里是全应用共享的调色与控件样式，
             放进去会让"谁在用"这件事从此不可见。 -->
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="3"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="Tick"
                                          Data="M 0,3.5 L 3,6.5 L 8,1"
                                          Stroke="{DynamicResource TextOnAccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 九宫格里的一格。
             Loaded 是**取图的唯一触发点**：条目 VM 是整批创建的（虚拟化只回收容器、不回收 VM），
             若在建 VM 时就发请求，一页 20 条 × 最多 9 张会同时涌向后端（并发闸门在 MomentMediaLoader 里）。
             空白格（上游没给定位参数的那些）不发请求，只画占位块。
             点击打开大图：走命令而不是 Click 事件，是因为这里需要拿到"被点的哪一格"，
             而 CommandParameter 天然就是这一格的 DataContext。 -->
        <DataTemplate x:Key="MediaCellTemplate">
            <Button Padding="0"
                    MinWidth="0"
                    MinHeight="0"
                    Width="{Binding CellWidth}"
                    Height="{Binding CellHeight}"
                    Margin="0,0,6,6"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="{Binding ToolTipText}"
                    Command="{Binding DataContext.Moments.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Loaded="OnMediaCellLoaded">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource SubtleBrush}"
                                CornerRadius="4"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 占位块就是这个底色 Border：加载中什么都不写（九宫格里一排"正在加载…"比空白更吵）。 -->
                                <Image Source="{Binding Image}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding StateText}"
                                           Margin="4"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding HasStateText, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- 一张卡片 = 头像 + 昵称 + 时间 + 文字 + 九宫格 + 点赞评论 + 位置。
             刻意**不做**"列表 + 详情"两栏：朋友圈的内容本身就是流，同一张动态显示两遍没有意义。 -->
        <DataTemplate x:Key="PostCardTemplate">
            <Border Margin="14,8,14,0"
                    Padding="14"
                    CornerRadius="6"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 首字母头像：DTO 里没有头像地址字段（§14.8.1 实测清单），
                             所以这里不取图，也就没有"头像加载失败"这种状态。 -->
                        <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="{DynamicResource SubtleBrush}">
                            <TextBlock Text="{Binding AvatarText}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <!-- 时间直接用后端归一好的文本：原始 createTime 只用于回传给取图接口。 -->
                            <TextBlock Text="{Binding TimeText}"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ContentText}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding TitleText}"
                               Margin="0,8,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />

                    <!-- 视频号 / 公众号这类没有正文的内容：外链退化成**文本**展示（可选中、可复制），
                         刻意不做"点击打开浏览器"——进程外副作用不该藏在一张纯展示的卡片里。 -->
                    <TextBlock Text="{Binding ContentUrlText}"
                               Margin="0,6,0,0"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ContentUrlText}"
                               Foreground="{DynamicResource LinkBrush}"
                               Visibility="{Binding HasContentUrl, Converter={StaticResource BoolToVis}}" />

                    <!-- 九宫格：固定 96 的格子 + WrapPanel 自动折行。
                         为什么不用 UniformGrid：它按可用宽度**均分**列宽，卡片很宽时缩略图会被拉伸到几百像素；
                         WrapPanel + 固定格子在窄窗口里还会自然折行。单图那格由格子 VM 给 220 × 比例高度。 -->
                    <ItemsControl ItemsSource="{Binding Media}"
                                  ItemTemplate="{StaticResource MediaCellTemplate}"
                                  Margin="0,10,0,-6"
                                  HorizontalAlignment="Left"
                                  Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 点赞 / 评论：结构未实测（§7.11），能稳妥取到文本就渲染，否则退化成计数提示；
                         两者都取不到时整块不出现（HasSocial=false），不留一个空灰块。 -->
                    <Border Margin="0,10,0,0"
                            Padding="10,6"
                            CornerRadius="4"
                            Background="{DynamicResource PanelBrush}"
                            Visibility="{Binding HasSocial, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding LikeLine}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Visibility="{Binding HasLikes, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding CommentLine}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding MetaText}"
                               Margin="0,8,0,0"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 「按人筛选」的一行：勾选框管成员、整行点击也切换（与联系人模块同一套 ListBox 用法）。 -->
        <DataTemplate x:Key="UserRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Style="{StaticResource ThemedCheckBox}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Margin="6,0,4,0"
                           Text="{Binding DisplayName}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding User.Username}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding CountText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 朋友圈模块（T23）：左 240 筛选栏 + 右动态流。
         本控件不设置 DataContext，绑定全部继承 MainWindow 的 MainViewModel。 -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左列：筛选栏 ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 行 0：标题 + 计数 -->
                <StackPanel Grid.Row="0" Margin="14,14,14,0">
                    <TextBlock Text="朋友圈"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Moments.CountText}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <!-- 行 1：两条横幅，各占一行、按需出现（颜色全部用 key，不写字面量色值）。 -->
                <StackPanel Grid.Row="1" Margin="14,10,14,0">
                    <Border Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerSoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Visibility="{Binding Moments.HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Moments.ErrorMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                    <Border Margin="0,6,0,0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Visibility="{Binding Moments.HasSourceFallback, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Moments.SourceFallbackText}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- 行 2：关键词。改动**不**自动请求，由「应用」/ 回车触发（服务端过滤）。
                     注意：关键词只作用于时间线，导出接口没有这个参数（见导出窗口里的说明）。 -->
                <StackPanel Grid.Row="2" Margin="14,12,14,0">
                    <TextBlock Text="内容关键词"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Moments.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按动态内容搜索，回车即应用（服务端过滤）"
                                 KeyDown="OnKeywordKeyDown" />
                        <Button Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="10,3"
                                MinWidth="0"
                                FontSize="12"
                                Content="应用"
                                ToolTip="用当前勾选的人与关键词重查一次"
                                Command="{Binding Moments.ApplyCommand}" />
                    </Grid>
                </StackPanel>

                <!-- 行 3：同步最新。进模块时自动调一次，其余时候只由这个按钮触发——
                     不要每次滚动都调（§14.8.3）。 -->
                <StackPanel Grid.Row="3" Margin="14,12,14,0">
                    <Button Content="同步最新"
                            Padding="10,3"
                            MinWidth="0"
                            FontSize="12"
                            HorizontalAlignment="Left"
                            ToolTip="把实时朋友圈的增量同步进解密库，然后重查第一页"
                            Command="{Binding Moments.SyncLatestCommand}">
                        <!-- 同步在途、或正在重查第一页时禁用按钮：再点一次没有意义，
                             而"按钮没反应"比"按钮变灰"更让人困惑。
                             用 DataTrigger 而不是取反转换器：Theme.xaml 里只有 BoolToVis，
                             为一个按钮往那里加一个 key 不值得（那个文件后续会被主题任务整体重构）。 -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Moments.IsSyncing}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Moments.IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding Moments.SyncStatusText}"
                               Margin="0,6,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding Moments.HasSyncStatus, Converter={StaticResource BoolToVis}}" />

                    <!-- 导出入口放在这里而不是工具栏：导出永远需要一个"导什么"的上下文，
                         本模块的上下文就是左栏勾选的发布人（勾选即生效，不必先点「应用」）。
                         产物是 ZIP，格式由微信数据源决定，所以去向是一个独立弹窗。 -->
                    <Button Margin="0,10,0,0"
                            Padding="10,4"
                            MinWidth="0"
                            FontSize="12"
                            HorizontalAlignment="Left"
                            Content="导出…"
                            ToolTip="按左栏勾选的发布人导出朋友圈（未勾选时导出全部；异步任务，产物为 ZIP）"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnExportClick" />
                </StackPanel>

                <!-- 行 4：按人筛选的标题与两个批量动作。数据来自 /api/sns/users（每人发过多少条）。 -->
                <Grid Grid.Row="4" Margin="14,14,14,0">
                    <TextBlock Text="按人筛选"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="全选"
                                Padding="8,2"
                                MinWidth="0"
                                FontSize="11"
                                Command="{Binding Moments.SelectAllUsersCommand}" />
                        <Button Content="清除"
                                Margin="6,0,0,0"
                                Padding="8,2"
                                MinWidth="0"
                                FontSize="11"
                                ToolTip="清空勾选 = 看全部人的朋友圈"
                                Command="{Binding Moments.ClearUserFilterCommand}" />
                    </StackPanel>
                </Grid>

                <!-- 行 5：发布人列表。选人之后要点「应用」才生效（与关键词同一条约定）。
                     列表占满剩余高度：人数可能上千（上游 limit=5000），必须自己滚动。 -->
                <ListBox Grid.Row="5"
                         Margin="8,4,8,12"
                         ItemsSource="{Binding Moments.Users}"
                         ItemTemplate="{StaticResource UserRowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- 整行点击 = 勾选这一行：否则会出现"ListBox 自己一套选中、勾选框另一套"两个互不相干的状态。 -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== 右列：动态流 ==================== -->
        <Grid Grid.Column="1">
            <!-- 为什么用 ListBox 而不是 ScrollViewer + ItemsControl：卡片数量会随滚动累积（每页 20 条），
                 必须吃 ListBox 自带的容器虚拟化。本项目别处（守护对象 / 定时任务 / AI 对话）刻意选了
                 ScrollViewer + ItemsControl，但那些列表只有个位数行；这里没有 FlowDocument 那种
                 "容器不能回收"的限制（§7.5 决定 2 只针对 FlowDocument），Image 可以安全重建。
                 VirtualizationMode 显式写 Standard：Recycling 复用同一个容器只改 DataContext，
                 格子的 Loaded 不会再触发，取图就永远不发生了。 -->
            <ListBox ItemsSource="{Binding Moments.Timeline}"
                     ItemTemplate="{StaticResource PostCardTemplate}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,0,12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.VirtualizationMode="Standard"
                     ScrollViewer.ScrollChanged="OnTimelineScrollChanged">
                <!-- 卡片流不是"选择列表"：去掉行高亮与内边距，否则鼠标滑过每张卡片都会变色，
                     看起来像"选中了这一条"。 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 空态 / 加载中：与列表同格、后声明，靠 Z 序盖在上面（与联系人模块同一做法）。 -->
            <TextBlock Text="{Binding Moments.Placeholder}"
                       Margin="18,14,18,0"
                       VerticalAlignment="Top"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Moments.HasTimeline}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="正在加载更多……"
                       Margin="18,0,18,10"
                       VerticalAlignment="Bottom"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Visibility="{Binding Moments.IsLoadingMore, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ==================== 大图查看器（模块内遮罩） ====================
             为什么用遮罩而不是新开窗口：大图要贴着九宫格出现，独立窗口还要处理 Owner / 焦点 / 位置。
             代价是本模块是 Visibility 切换、**不销毁**的（§7.10 约定），遮罩会留在"打开"状态，
             所以三种关闭方式里必须有"切模块"（见 MomentsModuleView.xaml.cs 的 IsVisibleChanged）。 -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding Moments.IsViewerOpen, Converter={StaticResource BoolToVis}}">
            <!-- 空白处点击关闭：这一层铺满整块模块，是所有比它上层的元素之外的点击落点。 -->
            <Border Background="{DynamicResource OverlayBrush}" MouseLeftButtonDown="OnViewerOverlayClick" />

            <Grid Margin="40,32,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Moments.ViewerCaption}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentBrush}" />

                <Grid Grid.Row="1">
                    <!-- 点图片本身不关闭（把事件吃掉），只有空白处才关：否则"放大看细节"时一点就没了。 -->
                    <Image Source="{Binding Moments.ViewerImage}"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           Margin="0,12,0,0"
                           MouseLeftButtonDown="OnViewerImageClick"
                           Visibility="{Binding Moments.HasViewerImage, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding Moments.ViewerStateText}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               Visibility="{Binding Moments.HasViewerStateText, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
