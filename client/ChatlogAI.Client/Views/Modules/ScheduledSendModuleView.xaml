<UserControl x:Class="ChatlogAI.Client.Views.Modules.ScheduledSendModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- ThemedCheckBox 跟着它的使用方走：这个样式原来声明在 MainWindow 的 Window.Resources 里，
             唯一的用途就是本模块的两处勾选框（总开关 / 任务启用）。
             搬进模块自己的资源里以后，MainWindow 不必为一个只在子控件里用到的样式背负担；
             刻意**不**提升进 Themes/Theme.xaml —— 那里是全应用共享的调色与控件样式，
             只被一个模块使用的键放进去，等于让"谁在用"这件事从此不可见。
             与 AutoReplyWindow / ScheduledSendWindow 的处理一致：局部 key，不外扩。 -->
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="3"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="Tick"
                                          Data="M 0,3.5 L 3,6.5 L 8,1"
                                          Stroke="{DynamicResource TextOnAccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </MultiTrigger>
                            <!-- 声明在最后：勾选与禁用同时成立时，禁用态说了算。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 定时发送模块（T16）：原主界面最左 232px 那一栏整体搬入。
         搬走的是"配置入口"（模型 / 自动回复 / 导出）那一段：它们在语义上从来不属于定时发送，
         现在分别归到「设置」模块与聊天模块的工具栏。
         本控件不设置 DataContext，绑定全部继承 MainWindow 的 MainViewModel。 -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" MinWidth="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 行 0：标题 + 总开关 + 状态。总开关的 IsChecked 一改就落盘（见 ScheduledSendViewModel.Enabled）。 -->
                <StackPanel Grid.Row="0" Margin="14,14,14,8">
                    <TextBlock Text="定时发送"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Margin="0,8,0,0"
                              Style="{StaticResource ThemedCheckBox}"
                              Content="启用定时发送"
                              IsChecked="{Binding ScheduledSend.Enabled, Mode=TwoWay}"
                              IsEnabled="{Binding ScheduledSend.IsAvailable}" />
                    <TextBlock Text="{Binding ScheduledSend.StatusText}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 行 1：任务列表。刻意用 ScrollViewer + ItemsControl 而不是 ListBox：
                     每行内嵌勾选框与两个按钮，ListBox 的容器虚拟化会在滚动时回收容器导致交互元素失位
                     （与 AutoReplyWindow 的候选列表同一理由）。 -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,0,14,8">
                        <ItemsControl ItemsSource="{Binding ScheduledSend.Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="8"
                                            CornerRadius="6"
                                            Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TargetName}"
                                                               MaxWidth="110"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TargetTypeText}"
                                                               Margin="6,0,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <CheckBox HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource ThemedCheckBox}"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          ToolTip="本任务是否生效" />
                                            </Grid>
                                            <TextBlock Text="{Binding RuleText}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding NextFireText}"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding LastSentText}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="编辑"
                                                        Padding="8,2"
                                                        MinWidth="0"
                                                        FontSize="11"
                                                        Click="OnScheduledTaskEditClick" />
                                                <Button Content="删除"
                                                        Margin="6,0,0,0"
                                                        Padding="8,2"
                                                        MinWidth="0"
                                                        FontSize="11"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.ScheduledSend.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空态：与列表同格、后声明，靠 Z 序盖在上面。 -->
                    <TextBlock Text="{Binding ScheduledSend.Placeholder}"
                               Margin="14,4,14,0"
                               VerticalAlignment="Top"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScheduledSend.HasTasks}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 行 2：新增任务入口。 -->
                <Button Grid.Row="2"
                        Content="新增任务"
                        Margin="14,0,14,10"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding ScheduledSend.IsAvailable}"
                        Click="OnScheduledTaskAddClick" />
            </Grid>
        </Border>

        <!-- 详情区（对应 §14.2.2 的"列表栏 + 详情区"）。
             本轮只放说明文案：任务详情（下次触发 / 上次发送汇总）还没有确定的内容形态，
             先不编造绑定，免得日后要连结构与 VM 一起推倒重建。 -->
        <Border Grid.Column="1" Background="{DynamicResource PageBrush}">
            <StackPanel Margin="32,32,32,0" VerticalAlignment="Top">
                <TextBlock Text="定时发送"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="任务到点由后台引擎自动发出，不依赖本窗口是否打开。"
                           Margin="0,10,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="启用 / 新建 / 编辑 / 删除都在左侧任务列表上操作；到点后可在任务卡片上看到下次触发与上次发送时间。"
                           Margin="0,6,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
