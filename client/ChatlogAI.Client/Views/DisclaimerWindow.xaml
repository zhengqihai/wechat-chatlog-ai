<Window x:Class="ChatlogAI.Client.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="免责声明"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 启动免责声明（T17）。
         为什么用自定义 Window 而不是 MessageBox：文案是四段，还要承载"不再提示"勾选，
         MessageBox 的形态与返回值都表达不了（它没有可勾选的第三态）。
         窗口只做"显示 + 记一个勾选状态"，不做"不同意就退出"的门禁：
         它是声明，不是许可协议（§14.5.3）。 -->

    <Window.Resources>
        <!-- 局部 CheckBox 样式。默认 Aero2 模板在这套配色下会画出一个"白底方框"，
             压在深色卡片上非常突兀；而这里是每次启动都会出现的界面，必须自带一份。
             内容与 AutoReplyWindow / ScheduledSendWindow / ContactsModuleView 里的
             ThemedCheckBox 逐行一致（同样的 key 名，便于以后合并）：那三处都是各自窗口
             的局部样式，StaticResource 只在所属窗口内可见，本窗口引用不到。
             "四份副本"是既有事实，把它上提到 Theme.xaml 属于另一件事（见交付说明）。 -->
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- 整行透明底 = 整行可点。背景必须显式 Transparent：
                             null 笔刷不参与命中测试，留空会导致"点文字不勾选"。 -->
                        <Border Background="Transparent" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="3"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="Tick"
                                          Data="M 0,3.5 L 3,6.5 L 8,1"
                                          Stroke="{DynamicResource TextOnAccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </MultiTrigger>
                            <!-- 声明在最后：勾选/悬停与禁用态同时成立时，禁用态说了算。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="免责声明"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <Border Height="1"
                Margin="0,12,0,0"
                Background="{DynamicResource LineBrush}" />

        <!-- 文案四段，逐字按需求原文。两处刻意**没有**按建议修改，等用户明确表态：
               1) "违则后果自行承担"：建议改"违者"，未改；
               2) "该程序不会泄漏用户任何数据"：建议补"仅在本地读取"的边界，未改。
             唯一改过的是错字"严谨"→"严禁"（"严谨用于商业用途"整句无意义，
             而"严禁"才是这句免责声明的效力所在）。 -->
        <TextBlock Margin="0,16,0,0"
                   Text="本程序仅供个人学习用途，严禁用于商业用途，违则后果自行承担。"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Margin="0,8,0,0"
                   Text="该程序不会泄漏用户任何数据。"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Margin="0,8,0,0"
                   Text="使用该程序造成的一切后果由使用者个人承担。"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Margin="0,8,0,0"
                   Text="特此说明"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <CheckBox x:Name="DontShowAgain"
                  Margin="0,18,0,0"
                  Style="{StaticResource ThemedCheckBox}"
                  Content="不再提示" />

        <!-- 只做"关闭"，不做任何门禁：不写 Click 处理器，直接靠 IsDefault / IsCancel
             让回车与 Esc 都能关掉（IsCancel 的语义就是"关掉对话框"，返回 false，
             这里不关心返回值）。勾选状态的落盘放在窗口的 Closed 事件里统一处理，
             这样"点按钮""按 Esc""点右上角 X"三条路径的结果完全一致。
             注意不要再额外写 Close()：DialogResult 的关闭与 Close() 叠加会有时序问题。 -->
        <Button Margin="0,16,0,0"
                HorizontalAlignment="Right"
                MinWidth="96"
                Style="{StaticResource PrimaryButton}"
                Content="我知道了"
                IsDefault="True"
                IsCancel="True" />
    </StackPanel>
</Window>
