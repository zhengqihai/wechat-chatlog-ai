<Window x:Class="ChatlogAI.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modules="clr-namespace:ChatlogAI.Client.Views.Modules"
        Title="Chatlog AI"
        Height="800" Width="1600"
        MinHeight="560" MinWidth="1574"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 两栏布局（T16 导航重构）：[ 图标栏 56 ] [ 内容宿主（跟随 CurrentModule） ]。
         各模块内部的列（聊天三栏 / 设置单栏）都由模块 UserControl 自己声明，
         本窗口只负责"图标栏 + 内容宿主"，加模块不必再回来改列定义。

         MinWidth 算据：56（图标栏）+ 240（会话列表）+ 640（消息+筛选：横向 StackPanel 的天然宽度，
         不换行，是这一屏真正的硬约束）+ 260（会话洞察）+ 360（AI 分析）= 1556，再留 18px 窗口边框余量 → 1574。
         余量口径与旧值一致（旧 1490 = 四栏 1472 + 18）。
         注意 56 是**取代**原来的 232 定时发送栏，不是叠加：旧值里含那 232，新布局已无此栏。 -->

    <Window.Resources>
        <!-- 图标栏两个样式（T16）。刻意只做局部 key：
             它们的形状（56px 栏位、圆角高亮块）只对这条栏有意义，塞进 Theme.xaml 会让"谁在用"不可见。 -->

        <!-- 模块入口：用互斥单选语义表达"当前是哪个视图"。
             IsChecked 默认就是双向绑定，这里显式写出来：用户点击要能写回 VM.CurrentModule。 -->
        <Style x:Key="IconRailNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Margin="4,2"
                                Padding="0,8"
                                CornerRadius="6"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleBrush}" />
                            </Trigger>
                            <!-- 选中态：浅绿底 + 绿字，与 AI 分析栏的预设按钮同一套表达。 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 头像 / 主题 / 退出：同样是"栏位里的按钮"，但不是"当前视图"，所以不用 RadioButton。 -->
        <Style x:Key="IconRailButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Margin="4,2"
                                Padding="0,8"
                                CornerRadius="6"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 图标栏（仿微信，56px） ====================
             图标上用文字而不是图形：项目里没有图标资源（Assets 下只有 app.ico），
             画一套矢量图标属于本次重构之外的事，先用模块名顶着，位置与语义都是对的。 -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部：账号头像 = **当前账号指示器**（T19-B）。
                     为什么它必须常驻可见：切换账号后存在一个危险窗口——数据源已指向 B，
                     而微信客户端还登录着 A，此时键盘模拟出的回复可能落进 A 的同名会话且不可撤销。
                     所以"当前是哪个账号"与"是否有待确认的切换"都是安全信息，不能只藏在某个窗口里。
                     显示名来自上游 accounts[].name，而上游是客户端启动之后才拉起的：
                     拿不到时降级显示 account 的前两个字符，并由 ViewModel 在上游就绪后补拉一次。 -->
                <Button Grid.Row="0"
                        Margin="0,12,0,0"
                        Style="{StaticResource IconRailButton}"
                        Click="OnAccountAvatarClick"
                        ToolTip="{Binding AccountTooltip}">
                    <Grid Width="34" Height="34">
                        <Border CornerRadius="17"
                                Background="{DynamicResource SubtleBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding CurrentAccountShort}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <!-- 待确认警示角标：这是唯一能让用户看出"机器人为什么不回复"的常驻提示——
                             闸门只拦发送、不拦检测，所以自动回复那边看起来一切都是正常的。 -->
                        <Border Width="10"
                                Height="10"
                                CornerRadius="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource DangerBrush}"
                                BorderBrush="{DynamicResource CardBrush}"
                                BorderThickness="1.5"
                                Visibility="{Binding HasPendingAccountSwitch, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>

                <!-- 中部：五个模块入口。互斥由 RadioButton + GroupName 保证，
                     不用 ListBox 假装：ListBox 表达的是"选中了哪一行数据"，
                     用它还得额外处理键盘导航、选中高亮与"假选中"。
                     选中态与内容宿主都绑同一个 CurrentModule 投影，只有一处状态。 -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <RadioButton GroupName="MainModuleNav"
                                 Style="{StaticResource IconRailNavButton}"
                                 Content="聊天"
                                 ToolTip="聊天"
                                 IsChecked="{Binding IsChatModule, Mode=TwoWay}" />
                    <RadioButton GroupName="MainModuleNav"
                                 Style="{StaticResource IconRailNavButton}"
                                 Content="定时任务"
                                 ToolTip="定时任务"
                                 IsChecked="{Binding IsScheduledSendModule, Mode=TwoWay}" />
                    <RadioButton GroupName="MainModuleNav"
                                 Style="{StaticResource IconRailNavButton}"
                                 Content="朋友圈"
                                 ToolTip="朋友圈"
                                 IsChecked="{Binding IsMomentsModule, Mode=TwoWay}" />
                    <RadioButton GroupName="MainModuleNav"
                                 Style="{StaticResource IconRailNavButton}"
                                 Content="联系人"
                                 ToolTip="联系人"
                                 IsChecked="{Binding IsContactsModule, Mode=TwoWay}" />
                    <RadioButton GroupName="MainModuleNav"
                                 Style="{StaticResource IconRailNavButton}"
                                 Content="文档"
                                 ToolTip="文档"
                                 IsChecked="{Binding IsDocsModule, Mode=TwoWay}" />
                    <RadioButton GroupName="MainModuleNav"
                                 Style="{StaticResource IconRailNavButton}"
                                 Content="设置"
                                 ToolTip="设置"
                                 IsChecked="{Binding IsSettingsModule, Mode=TwoWay}" />
                </StackPanel>

                <!-- 底部：主题切换与退出。
                     退出从会话列表顶部搬到这里：它是窗口级动作，不属于任何模块。
                     主题按钮的 Content 显示的是**当前主题**（浅色 / 深色），不是"点了会变成什么"，
                     用户扫一眼就能知道自己在哪个模式；真正的文案由 MainWindow.xaml.cs 的
                     UpdateThemeButton() 在构造时与每次切换后写入，这里写的 "主题" 只是
                     设计期占位（XAML 里没有"未设置"这种状态），运行期不会显示出来。
                     ToolTip 才表达"点下去会发生什么"。 -->
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource IconRailButton}"
                            Content="主题"
                            Click="OnThemeToggleClick" />
                    <Button Style="{StaticResource IconRailButton}"
                            Content="退出"
                            Click="OnExitClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 内容宿主 ====================
             五个模块都是独立的 UserControl，全部常驻可视树（长生命周期实例）：
             切模块只改 Visibility，不销毁重建 —— 否则每次切回聊天都会重新订阅 VM 事件、
             丢掉列表滚动位置，等于把 §7.5 那个"事件打到已卸载控件"的坑重新挖一遍。

             Visibility 一律写在 Style + DataTrigger 里，不写元素上的局部值：
             局部值的优先级高于 Trigger 的 Setter，写了它，Trigger 就再也不生效了。
             绑定都是 {Binding IsXxxModule}，走 MainWindow 继承下来的 MainViewModel；
             模块自己**不设置** DataContext，理由见各模块 XAML 的注释。 -->
        <Grid Grid.Column="1">
            <modules:ChatModuleView>
                <modules:ChatModuleView.Style>
                    <Style TargetType="modules:ChatModuleView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatModule}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </modules:ChatModuleView.Style>
            </modules:ChatModuleView>

            <modules:ScheduledSendModuleView>
                <modules:ScheduledSendModuleView.Style>
                    <Style TargetType="modules:ScheduledSendModuleView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScheduledSendModule}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </modules:ScheduledSendModuleView.Style>
            </modules:ScheduledSendModuleView>

            <modules:MomentsModuleView>
                <modules:MomentsModuleView.Style>
                    <Style TargetType="modules:MomentsModuleView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMomentsModule}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </modules:MomentsModuleView.Style>
            </modules:MomentsModuleView>

            <modules:ContactsModuleView>
                <modules:ContactsModuleView.Style>
                    <Style TargetType="modules:ContactsModuleView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsContactsModule}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </modules:ContactsModuleView.Style>
            </modules:ContactsModuleView>

            <modules:DocsModuleView>
                <modules:DocsModuleView.Style>
                    <Style TargetType="modules:DocsModuleView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDocsModule}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </modules:DocsModuleView.Style>
            </modules:DocsModuleView>

            <modules:SettingsModuleView>
                <modules:SettingsModuleView.Style>
                    <Style TargetType="modules:SettingsModuleView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsModule}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </modules:SettingsModuleView.Style>
            </modules:SettingsModuleView>
        </Grid>
    </Grid>
</Window>
