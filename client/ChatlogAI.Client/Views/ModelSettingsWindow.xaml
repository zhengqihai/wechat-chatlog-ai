<Window x:Class="ChatlogAI.Client.Views.ModelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型与 API Key 设置"
        Width="640"
        MaxHeight="760"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 用独立的模态窗口，而不是主界面里的内联遮罩 —— 与网页版的取舍正好相反：
         网页只有一页，遮罩是顺手的选择；桌面端这里要调模型（验证 Key 最长 180 秒）、
         要连续做"加一个 / 切一个 / 删一个"多步操作，独立窗口在焦点归属、
         关闭时机、"主界面被挡住不会误点"这三件事上都是现成的，不用自己实现。
         代价是它与主界面之间不能共享控件状态，所以回刷只能走 VM 之间的回调
         （见 ModelSettingsViewModel._onProvidersChanged）。 -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 0 已配置的供应商：小标题 -->
            <RowDefinition Height="Auto" />
            <!-- 1 已配置的供应商：列表 -->
            <RowDefinition Height="Auto" />
            <!-- 2 分隔线 -->
            <RowDefinition Height="Auto" />
            <!-- 3 表单：标题 -->
            <RowDefinition Height="Auto" />
            <!-- 4 表单：字段 -->
            <RowDefinition Height="Auto" />
            <!-- 5 验证结果提示 -->
            <RowDefinition Height="Auto" />
            <!-- 6 按钮行 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="已配置的模型供应商"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- 列表自己带滚动：窗口是 SizeToContent="Height"，供应商可能有十几条，
             不给上限的话窗口会被撑出屏幕，比滚动条更难用。 -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,8,0,0"
                      MaxHeight="220"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 空列表 / 读取失败共用这一格：文案由 VM 决定（Placeholder）。
                     读失败时列表同样是空的，用同一处提示比"再挂一个错误块"更少分支。 -->
                <TextBlock Text="{Binding Placeholder}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding HasNoProviders, Converter={StaticResource BoolToVis}}" />

                <!-- 用 ItemsControl 而不是 ListBox：这里没有"选中某一行"的语义，
                     整行的三个动作按钮各自带 CommandParameter，不需要选中态。
                     用 ListBox 反而要额外处理选中高亮和键盘导航。 -->
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="{DynamicResource PanelBrush}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- 三个按钮的命令都住在窗口级 VM（ModelSettingsViewModel）上，
                                         而这里的数据上下文是每行的 ProviderItemViewModel，
                                         所以必须 RelativeSource 往上找到 Window 再取 DataContext；
                                         行对象本身通过 CommandParameter 传进去（对照 MainWindow.xaml 里
                                         "复制 AI 回复"那个按钮的写法）。 -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="{Binding UseButtonText}"
                                                MinWidth="64"
                                                Padding="10,4"
                                                FontSize="12"
                                                IsEnabled="{Binding CanUse}"
                                                Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="编辑"
                                                MinWidth="56"
                                                Margin="6,0,0,0"
                                                Padding="10,4"
                                                FontSize="12"
                                                Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="删除"
                                                Style="{StaticResource DangerButton}"
                                                MinWidth="56"
                                                Margin="6,0,0,0"
                                                Padding="10,4"
                                                FontSize="12"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Height="1"
                Margin="0,16,0,16"
                Background="{DynamicResource LineBrush}" />

        <!-- 标题绑 FormTitle：编辑态显示"修改供应商"，与"添加供应商"区分开。
             没有这个区分，用户点完"编辑"后界面毫无变化，会以为按钮没反应。 -->
        <TextBlock Grid.Row="3"
                   Text="{Binding FormTitle}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="供应商类型"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <!-- 选项列表来自服务端下发的 presets（ProviderListResponse.Presets），
                     不在这里硬编码 —— 与 API_REFERENCE.md §3.2.1 一致。 -->
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Left"
                          MinWidth="200"
                          ItemsSource="{Binding Presets}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedProviderType, Mode=TwoWay}" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="显示名称"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <!-- 一律 UpdateSourceTrigger=PropertyChanged（对照网页版的 oninput）：
                     这几个字段的 setter 会作废"已验证"的结论，若等失焦才回写，
                     用户在框里改完直接点保存，点的是上一组参数的结论。 -->
                <TextBox Grid.Column="1"
                         Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Base URL"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="模型名"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="API Key"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <!-- PasswordBox.Password 不是依赖属性，绑不了；这里只挂事件，
                     由 code-behind 与 VM.ApiKey 双向同步（见 ModelSettingsWindow.xaml.cs）。
                     用 PasswordBox 而不是 TextBox 是照搬网页版的 <input type="password">：
                     Key 是明文凭证，不该在屏幕上直接可见。 -->
                <PasswordBox x:Name="ApiKeyBox"
                             Grid.Column="1"
                             PasswordChanged="OnApiKeyChanged" />
            </Grid>

            <TextBlock Margin="84,8,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="新增供应商必须先用该 Key 验证通过才能保存；修改时留空表示沿用原来的 Key。" />
        </StackPanel>

        <!-- 验证结果。颜色不在这里按成功/失败切换：网页版也没切，
             而这里更重要的信息是"能不能点保存"——那道门由 SaveCommand.CanExecute 控制。 -->
        <TextBlock Grid.Row="5"
                   Text="{Binding ValidateMessage}"
                   Margin="0,10,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" />

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="验证 Key"
                    MinWidth="92"
                    Command="{Binding ValidateCommand}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- 只在自己加的"编辑"态下出现：否则用户一旦点了编辑，就没有退路，
                     只能靠保存或删除来离开编辑态。这是补齐编辑能力时必须配的一个出口。 -->
                <Button Content="取消修改"
                        MinWidth="92"
                        Margin="8,0,0,0"
                        Command="{Binding CancelEditCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                <Button Content="关闭"
                        MinWidth="92"
                        Margin="8,0,0,0"
                        Click="OnCloseClick" />
                <Button Content="{Binding SaveButtonText}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="108"
                        Margin="8,0,0,0"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
