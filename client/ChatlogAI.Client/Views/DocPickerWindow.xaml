<Window x:Class="ChatlogAI.Client.Views.DocPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关联知识文档"
        Width="480"
        Height="480"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 知识文档多选器（T-F4）：多选文档，实时显示累计大小与 4MB 余量，超限禁用确定。 -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="关联知识文档"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="勾选的文档内容会在生成回复时注入到 system prompt（身份/知识背景）。累计超过 4MB 会被截断。" />

        <ListBox Grid.Row="2"
                 x:Name="DocList"
                 Margin="0,12,0,0"
                 Background="Transparent"
                 BorderBrush="{DynamicResource LineBrush}"
                 BorderThickness="1"
                 Padding="6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Padding="2"
                              Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="{Binding Filename}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SizeText}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3"
                   x:Name="SummaryText"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="取消"
                    MinWidth="84"
                    IsCancel="True" />
            <Button x:Name="ConfirmButton"
                    Content="确定"
                    MinWidth="84"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
