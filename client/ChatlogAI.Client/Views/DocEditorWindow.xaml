<Window x:Class="ChatlogAI.Client.Views.DocEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编写知识文档"
        Width="640"
        Height="560"
        MinWidth="480"
        MinHeight="400"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 知识文档编辑器（T-F4）：在 app 内直接填写文件名与正文，落库走 DocsModuleView 的同名校验。 -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="编写知识文档"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="支持 md / txt / html / json；单文档不超过 4MB。文件名与已有文档同名时会询问是否覆盖。" />

        <TextBlock Grid.Row="2"
                   Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="文件名（含扩展名）" />

        <TextBox x:Name="FilenameBox"
                 Grid.Row="2"
                 Margin="0,20,0,0"
                 Padding="8,4"
                 FontSize="13"
                 Text="untitled.md" />

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="正文" />

        <TextBox x:Name="ContentBox"
                 Grid.Row="3"
                 Margin="0,20,0,0"
                 Padding="8"
                 FontFamily="Consolas, Microsoft YaHei UI"
                 FontSize="13"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="取消"
                    MinWidth="84"
                    IsCancel="True" />
            <Button Content="保存"
                    MinWidth="84"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
