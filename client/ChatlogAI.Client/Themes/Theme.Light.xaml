<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         浅色主题：只放颜色 Brush，不放任何控件样式（T18）
         =========================================================================
         为什么把颜色单独拆出来（而不是把整份 Theme.xaml 复制两份）：
         控件模板（Button / TextBox / ComboBox / ListBoxItem）里全是
         DynamicResource 颜色引用，模板本身与主题无关。复制模板等于以后改一个
         模板要改两处，必然漂移；所以这里只搬"取值"，模板留在 Theme.xaml 一份。

         key 集合约束：本文件与 Theme.Dark.xaml 的 x:Key 必须逐项完全一致。
         漏一个 key，引用它的控件在另一套主题下会退回 Aero2 默认外观。

         文字色分三档是为了保证对比度（浅底上 WCAG AA 小字号 ≥ 4.5:1）：
           TextPrimary   #1F2329 → 白底约 14.3:1
           TextSecondary #5A6270 → 白底约  5.3:1
           TextMuted     #626A78 → 白底约  4.9:1
         以前深色主题用的 #8A8F9C 压在浅底上只有约 2.6:1，"看不清"就是这么来的。
         ========================================================================= -->

    <!-- ==================== 1. 基础色 ==================== -->
    <SolidColorBrush x:Key="PageBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#EFF1F4" />
    <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D5D9DF" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#B4BBC6" />

    <!-- ==================== 2. 文字色 ==================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2329" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6270" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#626A78" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- ==================== 3. 品牌绿（微信绿） ====================
         AccentBrush 是品牌色本体，只承担"点缀"：状态点、聚焦边框、选中指示。
         它不能直接当按钮底色配白字：与白色的对比度只有约 2.4:1，
         连 WCAG 的 3:1 非文本标准都够不上。所以"填充型"控件另开一组更深的
         AccentFill*，白字对比度约 5.1:1。
         另注（T24 已调整）：AccentFill* 原先同时兼任"强调色的文字用法"（选中态标题、
         预设按钮文字、点赞行等）。那个双重角色在深色主题下数学上无法同时满足，因此另开了一个
         专用 key AccentTextBrush 承担文字角色（见下方），AccentFill* 从此只做填充底色。 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#07C160" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#06AD56" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#059147" />

    <SolidColorBrush x:Key="AccentFillBrush" Color="#0A7F45" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#0B8C4C" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#086636" />

    <!-- 「强调色的文字用法」专用 key（T24）：AccentFillBrush 只做填充底色，凡把强调色当
         **文字**用的地方都用这个（浅绿底上的选中态标题、面板底上的点赞行等都算）。
         浅色下刻意取与 AccentFillBrush 相同的值，所以浅色模式相对改造前**视觉零变化**；
         开这个 key 是为了让深色主题能给两个方向相反的角色分别取值——填充要够暗才配白字，
         文字要够亮才压得住深底。 -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0A7F45" />

    <!-- 浅绿：自己发的消息气泡 / 列表选中行。刻意用"浅底 + 深字"而不是整块高饱和绿，
         整块铺色在长文本场景下会晃眼。 -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F7EE" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#BFE7D1" />

    <!-- ==================== 4. 状态色 ==================== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#07C160" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D93F3F" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#F5C6C6" />

    <!-- ==================== 5. 禁用态 ====================
         刻意用"灰底 + 仍可读的深灰字"，而不是 WPF 默认模板的"整体降透明度"：
         默认模板把禁用控件整体乘一个透明度系数，在浅底上直接糊掉，
         用户就完全看不到值了。 -->
    <SolidColorBrush x:Key="DisabledFillBrush" Color="#EDEFF2" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#DFE2E7" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5F6774" />

    <!-- ==================== 6. 遮罩 ==================== -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />

    <!-- ==================== 7. Markdown 渲染专用（C# 侧按同名 key 取用） ==================== -->
    <SolidColorBrush x:Key="QuoteBarBrush" Color="#D5D9DF" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="CodeInlineBackgroundBrush" Color="#EDEFF3" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#1F2329" />
    <SolidColorBrush x:Key="LinkBrush" Color="#0A7F45" />

</ResourceDictionary>
