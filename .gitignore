# ============================================================
# 注意：本文件必须保持 UTF-8 编码（无 BOM）。
# 曾因误存为 UTF-16 LE + BOM 导致 git 将其视为二进制、全部规则失效。
# ============================================================

# ---- 密钥类配置：绝不入库 ----
# config/config.example.json 是脱敏模板，需要入库，因此逐条精确忽略。
/config/config.json
/config/config.json.bak
/config/api-keys.json
/config/*.tmp

# ---- 提示词类配置：绝不入库（用户可自由修改，随环境生成）----
/config/prompts/
/config/auto-reply/
/config/scheduled-send/

# ---- 运行时数据：聊天记录、数据库、导出文件、缓存，含隐私且体积大 ----
/data/
/logs/

# ---- 无用的 node 运行时：不跟踪 ----
/runtime/node/

# ---- Python 字节码与缓存 ----
__pycache__/
*.py[cod]

# ---- 打包产物：staging 与安装包都由 build-installer.ps1 随时重建，不入库 ----
/client/build/

# ---- .NET 构建产物：由 dotnet build 随时重建，不入库 ----
/client/ChatlogAI.Client/bin/
/client/ChatlogAI.Client/obj/

# ---- 客户端自检产物：内含真实 key 与微信数据，绝不入库 ----
/client/out-data/

# ---- 构建脚本在沙箱环境下重定向的 NuGet 缓存，纯缓存可重建 ----
/.nuget-packages/
/.dotnet-appdata/

# ---- 编辑器与操作系统生成物 ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
debug.log
